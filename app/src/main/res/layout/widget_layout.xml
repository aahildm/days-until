<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF1A1A2E"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widgetClockSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/widgetClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:54"
            android:textSize="30sp"
            android:textColor="#FFFFFFFF" />

        <TextView
            android:id="@+id/widgetTodayDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tue, 8 Sep"
            android:textSize="12sp"
            android:textColor="#FF999999"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:id="@+id/widgetEventSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.4"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/widgetLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REMAINING"
            android:textSize="10sp"
            android:textColor="#FF888888"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widgetDays"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="44sp"
            android:textColor="#FFFFFFFF" />

        <TextView
            android:id="@+id/widgetDaysLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="days"
            android:textSize="13sp"
            android:textColor="#FFAAAAAA" />

        <TextView
            android:id="@+id/widgetDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date"
            android:textSize="11sp"
            android:textColor="#FFCCCCCC"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</LinearLayout>
