<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@android:color/transparent"
    android:padding="12dp">
    <LinearLayout
        android:id="@+id/widgetClockSection"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <TextView android:id="@+id/widgetClock"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="12:54" android:textSize="26sp" android:textColor="#FFFFFFFF"/>
        <TextView android:id="@+id/widgetTodayDate"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Tue, 8 Sep" android:textSize="11sp" android:textColor="#FF999999"
            android:layout_marginTop="4dp"/>
    </LinearLayout>
    <ImageView android:layout_width="1dp" android:layout_height="match_parent"
        android:background="#33FFFFFF" android:layout_marginStart="4dp" android:layout_marginEnd="4dp"/>
    <LinearLayout
        android:id="@+id/widgetEventSection"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.3"
        android:orientation="vertical"
        android:gravity="center">
        <LinearLayout
            android:id="@+id/widgetEvent1Block"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView android:id="@+id/widgetLabel"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="REMAINING" android:textSize="12sp" android:textColor="#FF888888"
                android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/widgetDays"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textSize="28sp" android:textColor="#FFFFFFFF"/>
            <TextView android:id="@+id/widgetDaysLabel"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="days" android:textSize="11sp" android:textColor="#FFAAAAAA"/>
            <TextView android:id="@+id/widgetDate"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Date" android:textSize="12sp" android:textColor="#FFCCCCCC"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <ImageView android:id="@+id/widgetEventDivider"
            android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#22FFFFFF" android:visibility="gone"/>
        <LinearLayout
            android:id="@+id/widgetEvent2Block"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">
            <TextView android:id="@+id/widgetLabel2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textSize="12sp" android:textColor="#FF888888"
                android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/widgetDays2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textSize="28sp" android:textColor="#FFFFFFFF"/>
            <TextView android:id="@+id/widgetDaysLabel2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="days" android:textSize="11sp" android:textColor="#FFAAAAAA"/>
            <TextView android:id="@+id/widgetDate2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textSize="12sp" android:textColor="#FFCCCCCC"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
